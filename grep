'use strict';
// The domain layer: room lifecycle, the turn loop, quota. It never touches HTTP.
// Invariant: every op is synchronous and ends by calling run() synchronously, so the status has flipped before the
// caller responds. The ops are ordered by JavaScript's run-to-completion; the only hazard is state that changes during
// an await (advance, finalise, a draft), so code after an await must not assume what it saw before it.
const crypto = require('crypto');
const { rateKey } = require('./net');
const pxp = require('./pxp');
const { ApiError, ProxyError, BudgetError, savingUnavailable, signinRequired, aiAccessRequired } = require('./errors');

const id = (n = 8) => crypto.randomBytes(n).toString('base64url').replace(/[-_]/g, '').slice(0, n + 2);
const defaultClock = { now: () => Date.now(), sleep: ms => new Promise(r => setTimeout(r, ms)) };
const agentLabel = seat => seat.agent || 'External agent';
const proxyLabel = seat => (seat.mode === 'external' ? agentLabel(seat) : 'Built-in Claude proxy');
const other = s => (s === 'A' ? 'B' : 'A');

// Limits.
const MAX_DRAFTS = 5; // per seat
const ADMIN_DAILY = 50; // live rooms per admin per day: finite, so a stolen admin session cannot open rooms without end
const MAX_PASSCODE_FAILS = 10; // wrong passcodes per address (or IPv6 /64) per day
const MAX_FAILED_KEYS = 500; // addresses tracked per day; later ones share the 'overflow' key
const MAX_OVERFLOW_FAILS = 50; // wrong passcodes per day from all untracked addresses together
const CALLS_PER_TURN = 3; // charged proxy calls allowed per turn of maxTurns (D12)
const CAPACITY_MARGIN = 0.95; // enforceCapacity evicts down to this share of maxRooms, so it does not run on every create
const HOUR_MS = 3600000;
const DAY_MS = 24 * HOUR_MS;

// Sentences a client may see. The detail of a failure goes to the log only (an upstream message can echo model output).
const DEMO_AGENT_MESSAGE = 'Demo rooms run scripted proxies. Create a live room to connect your own agent.';
const AI_ERROR = "The AI service didn't respond.";
const GENERIC_ERROR = 'Something went wrong in this room.';
const MAX_ROOMS_TODAY = 'You have opened the maximum live rooms for today. The demo is unlimited.';
const DAILY_LIMIT = 'Daily room limit reached. Try again tomorrow, or run the demo.';
const DRAFT_ERROR = "Couldn't draft the card right now. Try again, or fill it in yourself.";
// The only texts room.error may hold: hydrate and run() both go through this set.
const ROOM_ERRORS = new Set([AI_ERROR, GENERIC_ERROR]);

function newSeat() {
  return { token: id(16), name: '', card: null, cardHash: null, sealed: false, draftText: '', mode: 'builtin', agent: null };
}

// canCreateLiveRoom(): whether a new live room can be kept right now (the composition root knows the storage state).
// canUseAi(user) and isAdmin(user): whether the signed-in opener has "Use our AI" access (an admin always has), and whether they are
// an admin (lib/ai-access.js, which lib/app.js builds before the domain). Only asked with sign-in on; without them nobody has access.
// passcodeRequired(): whether a room opener must give the passcode; when false the passcode is not looked at at all (no guess is
// counted, so no address is ever locked out of a server that does not ask).
function createRooms({ config, signinOn, passcodeRequired = () => true, passcodeMatches, canCreateLiveRoom = () => true, canUseAi = () => false, isAdmin = () => false, store, proxy, demo, log, clock = defaultClock }) {
  const now = clock.now || defaultClock.now;
  const sleep = clock.sleep || defaultClock.sleep;
  const iso = () => new Date(now()).toISOString();
  const today = () => iso().slice(0, 10);
  const { roomTtlDays: ROOM_TTL_DAYS, demoTtlHours: DEMO_TTL_HOURS, maxRooms: MAX_ROOMS } = config;
  const { dailyRoomLimit: DAILY_ROOM_LIMIT, perIpDaily: PER_IP_DAILY, perUserDaily: PER_USER_DAILY, maxTurns: MAX_TURNS, demoDelayMs: DEMO_DELAY, publicUrl: PUBLIC_URL } = config;
  const SIGNIN_ON = Boolean(signinOn); // a live room then needs a user (the composition root decides)
  const rooms = store.state.rooms;
  const usage = store.state.usage;
  const listeners = [];
  const draftsInFlight = new Map(); // room id -> drafts awaiting the proxy (in memory only)
  let stopped = false;
  const unparsable = new Set(); // room ids whose timestamp could not be read (logged once)

  const seatLink = (room, s) => `${PUBLIC_URL}/room/${room.id}?seat=${s}&t=${room.seats[s].token}`;

  // The restart rules, applied once after the store has loaded.
  function hydrate() {
    for (const r of rooms.values()) {
      r.running = false; r.thinking = null;
      if (r.ai !== true && r.ai !== false) delete r.ai; // only an explicit false refuses; any other value is as if it had never been set
      // An error stored by an older build may carry upstream text. Only the fixed sentences are shown to clients.
      if (r.error && !ROOM_ERRORS.has(r.error)) r.error = GENERIC_ERROR;
      // A room whose AI allowance is spent can never take another turn: it ends as stalled, with its brief.
      if (resumable(r) && budgetSpent(r)) {
        try { endSpent(r); store.save(r.id); } catch (e) { log.error('room.hydrate_stall_failed', { room: r.id }, e); }
        continue;
      }
      // A built-in turn in flight is lost on restart; an external seat is simply still waiting.
      if (r.status === 'negotiating' && !r.waitingOn) { r.status = 'paused'; r.interrupted = true; }
    }
  }

  // fn(room, kind); kind is 'change', or 'evicted' (the room is no longer in rooms). Returns the unsubscribe function.
  function onChange(fn) {
    listeners.push(fn);
    return () => { const i = listeners.indexOf(fn); if (i >= 0) listeners.splice(i, 1); };
  }

  // For tests and shutdown: run() takes no further turns, and listeners hear nothing more from a stopped run.
  function stop() { stopped = true; }

  // Called by the proxy before every Claude call. A turn or authority call costs one of the room's maxTurns x 3 calls;
  // a draft is free (it is limited per seat). A stopped domain refuses, so a retry that wakes after stop() cannot bill.
  function chargeCall(room, kind) {
    if (stopped) throw new ApiError(503, 'The room is shutting down.', 'shutting_down');
    if (room.ai === false) throw aiAccessRequired(PUBLIC_URL); // the one choke point: every Claude call (a draft included) passes here
    if (kind === 'draft') return;
    const used = callsUsed(room);
    if (used + 1 > callCap(room)) throw new BudgetError();
    room.apiCalls = used + 1;
    store.save(room.id);
  }

  // The budget fails closed: a room with a damaged turn limit falls back to the configured one, then to 10, and a damaged
  // call count counts as spent.
  const positive = (n) => typeof n === 'number' && Number.isFinite(n) && n > 0;
  function callCap(room) {
    const turns = positive(room.maxTurns) && Number.isInteger(room.maxTurns) ? room.maxTurns : (positive(MAX_TURNS) ? MAX_TURNS : 10);
    return turns * CALLS_PER_TURN;
  }
  function callsUsed(room) {
    const n = room.apiCalls;
    if (n === undefined || n === null) return 0;
    return typeof n === 'number' && Number.isFinite(n) && n >= 0 ? n : callCap(room);
  }
  const budgetSpent = (room) => callsUsed(room) >= callCap(room);

  // Nothing more can be asked of the AI: finish with a brief, not a dead-end Resume.
  function endSpent(room) {
    stall(room, { turnLimit: false });
    room.error = null;
  }

  const resumable = (room) => ['error', 'paused'].includes(room.status) && !room.pending;
  const present = (room) => rooms.get(room.id) === room; // false once the room was evicted
  const halted = (room) => stopped || !present(room);

  function emit(room) {
    room.version = (room.version || 0) + 1;
    store.save(room.id);
    for (const fn of listeners) {
      try { fn(room, 'change'); } catch (e) { log.error('room.listener_failed', { room: room.id }, e); }
    }
  }

  // The turn cap also clears waitingOn and records turn_limit; running out of script only stalls the room.
  function stall(room, { turnLimit }) {
    room.status = 'stalled';
    if (turnLimit) {
      room.waitingOn = null;
      pxp.appendLedger(room, 'turn_limit', { turns: room.turnCount });
    }
    room.brief = buildBrief(room, {});
  }

  // names, modes and cards are optional { A, B } maps.
  function createRoom({ topic, demoMode, names, modes, cards, ownerId, ai }) {
    // A new id never reuses a live room or one the store skipped at load: a database backend still holds that record (the file
    // store only keeps it in its .partial copy), and a new room under its id would overwrite it.
    let roomId;
    do roomId = id(8); while (rooms.has(roomId) || store.isSkipped('room', roomId));
    const room = {
      id: roomId, topic: pxp.str(topic, 160) || 'Untitled room', demo: Boolean(demoMode),
      createdAt: iso(), status: 'drafting',
      seats: { A: newSeat(), B: newSeat() }, envelopes: [], claims: {}, ledger: [],
      turn: 'A', turnCount: 0, maxTurns: MAX_TURNS, pending: null, brief: null, error: null, waitingOn: null,
    };
    if (ownerId) room.ownerId = ownerId; // top-level only: never in a view, the ledger, a brief or an MCP result
    // Whether the opener could use the built-in Claude. Only a live room has it; a room from before it existed has none and counts as
    // allowed (it was opened behind the passcode): only an explicit false refuses.
    if (ai !== undefined) room.ai = ai;
    if (room.demo) room.seats.B.token = room.seats.A.token; // one person drives both seats in the demo
    for (const s of ['A', 'B']) {
      if (names) room.seats[s].name = names[s];
      if (modes) room.seats[s].mode = modes[s];
      if (cards) room.seats[s].card = cards[s];
    }
    pxp.appendLedger(room, 'room_opened', { topic: room.topic, protocol: 'PXP/0' });
    rooms.set(room.id, room);
    store.save(room.id);
    enforceCapacity(room);
    return room;
  }

  function createDemoRoom() {
    return createRoom({ topic: demo.topic, demoMode: true, cards: { A: pxp.normaliseCard(demo.cards.A), B: pxp.normaliseCard(demo.cards.B) } });
  }

  function rollDay() {
    if (usage.day !== today()) store.resetUsage(today());
  }

  // Wrong guesses are counted per address per day, and the limit applies before the guess is looked at. The table holds
  // at most MAX_FAILED_KEYS addresses: once it is full, a new address is counted under the shared 'overflow' key, which
  // has its own limit, and the addresses already in the table keep theirs.
  function checkPasscode(ip, guess) {
    rollDay();
    const failed = usage.failedByIp;
    let key = rateKey(ip);
    if (!(key in failed) && Object.keys(failed).length >= MAX_FAILED_KEYS) key = 'overflow';
    const fails = failed[key] || 0;
    if (fails >= (key === 'overflow' ? MAX_OVERFLOW_FAILS : MAX_PASSCODE_FAILS)) throw new ApiError(429, 'Too many wrong passcodes. Try again tomorrow.');
    if (passcodeMatches(guess)) return;
    failed[key] = fails + 1;
    store.saveUsage();
    throw new ApiError(403, 'Wrong or missing passcode.');
  }

  // With an owner (sign-in on) the allowance is the account's (usage.byUser, by user id) and the address is not counted: several people
  // behind one address each get their own. With no owner (sign-in off) it is the address's, counted under rateKey like the passcode
  // guesses: one /64, or one IPv4 in either spelling, shares a quota. Throws the 429; nothing is counted before every limit has passed.
  // An admin or a granted user is exempt from the global limit (and does not count toward it), so free accounts cannot use it up on
  // them; an admin has their own cap, ADMIN_DAILY.
  function takeQuota(ip, owner) {
    rollDay();
    const exempt = Boolean(owner) && canUseAi(owner);
    if (usage.total >= DAILY_ROOM_LIMIT && !exempt) throw new ApiError(429, DAILY_LIMIT, 'daily_limit');
    const [counts, key, cap, code] = owner ? [usage.byUser, owner.id, isAdmin(owner) ? ADMIN_DAILY : PER_USER_DAILY, 'user_limit'] : [usage.byIp, rateKey(ip), PER_IP_DAILY, 'ip_limit'];
    if ((counts[key] || 0) >= cap) throw new ApiError(429, MAX_ROOMS_TODAY, code);
    if (!exempt) usage.total++;
    counts[key] = (counts[key] || 0) + 1;
    store.saveUsage();
  }

  // `user` ({ id, login }) is the signed-in opener, from the transport (the session or the agent key), never from the request body.
  function createLiveRoom(ip, { topic, nameA, nameB, modeA, modeB, passcode }, user) {
    if (SIGNIN_ON && !user) throw signinRequired();
    const owner = SIGNIN_ON ? user : null; // sign-in off: the domain ignores any user
    const modes = { A: modeA === 'external' ? 'external' : 'builtin', B: modeB === 'external' ? 'external' : 'builtin' };
    if (!proxy.live() && (modes.A === 'builtin' || modes.B === 'builtin')) {
      throw new ApiError(503, "Built-in Claude proxies aren't enabled on this server yet. Choose \"Bring your own agent\" for both seats.");
    }
    // Sign-in on: the built-in Claude is the owner's money, so a built-in seat (either one, from the web or from MCP) needs access.
    // The room remembers whether its opener had it (room.ai): drafts and the authority audit check that, not the opener's later status.
    const ai = SIGNIN_ON ? canUseAi(owner) : true;
    if (SIGNIN_ON && !ai && (modes.A === 'builtin' || modes.B === 'builtin')) throw aiAccessRequired(PUBLIC_URL);
    if (passcodeRequired()) checkPasscode(ip, passcode);
    if (!canCreateLiveRoom()) throw savingUnavailable();
    takeQuota(ip, owner);
    return createRoom({ topic, names: { A: pxp.str(nameA, 80), B: pxp.str(nameB, 80) }, modes, ownerId: owner && owner.id, ai });
  }

  function sealCard(room, seatId, cardInput, via) {
    const seat = room.seats[seatId];
    if (seat.sealed) throw new ApiError(409, 'Card already sealed.');
    const card = pxp.normaliseCard(cardInput, seat.name);
    const errs = pxp.validateCard(card);
    if (errs.length) throw new ApiError(400, errs.join('; '));
    const cardHash = pxp.hashOf(card); // hash first: a card that cannot be hashed never reaches the seat
    seat.card = card;
    seat.cardHash = cardHash;
    seat.sealed = true;
    seat.sealedVia = via;
    pxp.appendLedger(room, 'card_sealed', { seat: seatId, principal: card.principal.name, card_hash: seat.cardHash, via });
    emit(room);
    startIfReady(room);
  }

  function joinAsAgent(room, seatId, agentName) {
    const seat = room.seats[seatId];
    if (room.demo) throw new ApiError(400, DEMO_AGENT_MESSAGE);
    if (seat.mode !== 'external') {
      if (room.status !== 'drafting') throw new ApiError(409, "This seat already has a built-in proxy negotiating. An agent can only take over a seat before negotiation starts.");
      seat.mode = 'external';
    }
    const name = pxp.str(agentName, 60) || 'External agent';
    if (seat.agent !== name) {
      seat.agent = name;
      pxp.appendLedger(room, 'agent_joined', { seat: seatId, agent: name });
      emit(room);
    }
  }

  // Ask Claude to draft the seat's card from a plain-language brief. Resolves with the card.
  // The markers in test/room-view.test.js rely on this order: rollDay..sealCard, draftCard..answerEscalation,
  // resume..startIfReady.
  async function draftCard(room, seatId, body) {
    const seat = room.seats[seatId];
    if (seat.sealed) throw new ApiError(409, 'Card already sealed.');
    if (room.demo) throw new ApiError(400, 'Demo cards are pre-filled.');
    if (room.ai === false) throw aiAccessRequired(PUBLIC_URL); // the opener had no "Use our AI" access: a draft spends Claude
    if (!proxy.live()) throw new ApiError(503, 'Drafting with Claude is not enabled on this server. Fill in the card yourself.');
    const text = pxp.str(body.text, 4000);
    const name = pxp.str(body.name, 80) || seat.name;
    if (!text || !name) throw new ApiError(400, 'Add your name and a brief.');
    // Limit first, then count, with no await in between: concurrent drafts cannot all pass the check.
    if ((seat.drafts || 0) >= MAX_DRAFTS) throw new ApiError(429, 'Draft limit reached for this seat. Edit the card directly.');
    seat.drafts = (seat.drafts || 0) + 1;
    seat.name = name; seat.draftText = text;
    draftStarted(room);
    try {
      const card = await requestDraft(room, seatId, { name, role: pxp.str(body.role, 120), text });
      // The room may have been evicted, or the seat sealed, while the draft was in flight: the sealed card is what
      // gets negotiated.
      if (rooms.get(room.id) !== room) throw new ApiError(404, 'Room not found');
      if (seat.sealed || room.status !== 'drafting') throw new ApiError(409, 'Card already sealed.');
      seat.card = card;
      return card;
    } finally {
      draftEnded(room);
      emit(room); // every exit after the mutations above, so the counter and name are saved
    }
  }

  // Calls the proxy and returns the normalised card, or throws the error a client may see (502 for any upstream failure).
  async function requestDraft(room, seatId, { name, role, text }) {
    try {
      // room is passed for the per-room spend budget (item 8); the proxy ignores it today.
      const out = await proxy.draftCard({ room, name, role, topic: room.topic, text });
      out.principal = { ...(out.principal || {}), name };
      return pxp.normaliseCard(out, name);
    } catch (e) {
      if (e instanceof ApiError) throw e;
      log.error('room.draft_failed', { room: room.id, seat: seatId }, e);
      throw new ApiError(502, DRAFT_ERROR);
    }
  }

  function draftStarted(room) { draftsInFlight.set(room.id, (draftsInFlight.get(room.id) || 0) + 1); }
  function draftEnded(room) {
    const left = (draftsInFlight.get(room.id) || 1) - 1;
    if (left > 0) draftsInFlight.set(room.id, left); else draftsInFlight.delete(room.id);
  }

  // True while the turn loop runs or a draft awaits the proxy: eviction must leave such a room alone.
  function busy(room) {
    return Boolean(room.running) || (draftsInFlight.get(room.id) || 0) > 0;
  }

  // Demo rooms are answered only through answerDemo (the web route), which picks the scripted branch.
  function answerEscalation(room, seatId, answer, via) {
    if (room.demo) throw new ApiError(400, DEMO_AGENT_MESSAGE);
    applyAnswer(room, seatId, answer, via);
  }

  function applyAnswer(room, seatId, answer, via) {
    assertPending(room, seatId);
    answer = pxp.str(answer, 1000);
    if (!answer) throw new ApiError(400, 'Write an answer for your proxy.');
    const env = room.envelopes.find(e => e.seq === room.pending.seq);
    if (env) { env.answer = answer; env.answer_via = via; }
    const seat = room.seats[seatId];
    seat.card.amendments.push({ question: room.pending.question, answer, at: iso() });
    seat.cardHash = pxp.hashOf(seat.card);
    pxp.appendLedger(room, 'principal_answer', { seat: seatId, speaker: 'principal', via, answer_hash: pxp.sha256(answer), card_hash: seat.cardHash });
    room.pending = null;
    room.turn = seatId; // the proxy that escalated resumes
    run(room);
  }

  function assertPending(room, seatId) {
    if (!room.pending || room.pending.seat !== seatId) throw new ApiError(409, 'No question is waiting for this seat.');
  }

  // The web answer route in a demo room: the chosen option picks the scripted branch, then the scripted answer follows.
  function answerDemo(room, seatId, option) {
    if (!room.demo) throw new ApiError(400, 'Only demo rooms take a scripted answer.');
    assertPending(room, seatId);
    const key = Object.prototype.hasOwnProperty.call(demo.choices, option) ? option : 'dedupe';
    room.branch = key;
    room.script = demo.branches[key].slice();
    applyAnswer(room, seatId, demo.answers[key], 'web');
  }

  // A failure the proxy already logged at error (proxy.failed / proxy.gave_up), the budget, or a shutdown refusal is expected, so it is a warning here; anything else is a defect in this room's own code.
  function logFailure(event, room, e) {
    const expected = e instanceof ProxyError || e instanceof BudgetError || (e instanceof ApiError && e.code === 503);
    log[expected ? 'warn' : 'error'](event, { room: room.id }, e);
  }

  async function finalise(room, acceptEnv) {
    const accepted = room.envelopes.find(e => e.seq === acceptEnv.accepts.seq);
    const terms = accepted.proposal.terms;
    const dependsOn = accepted.proposal.depends_on.map(cid => room.claims[cid]).filter(Boolean);
    const unverifiedDeps = dependsOn.filter(c => !c.verified);
    let authority = null;
    try {
      if (room.demo) authority = terms.map((t, i) => ({ term: t, ...(demo.authority[room.branch] || [])[i] }));
      else if (proxy.live() && room.ai !== false) authority = await proxy.mapAuthority(room, terms); // the audit spends Claude too
    } catch (e) { logFailure('brief.authority_failed', room, e); }

    const agreement = { terms, proposal_hash: accepted.proposal_hash, proposed_by: accepted.from.seat, proposed_seq: accepted.seq, accepted_by: acceptEnv.from.seat, accepted_seq: acceptEnv.seq };
    pxp.appendLedger(room, 'agreement', { proposal_hash: agreement.proposal_hash, proposed_by: agreement.proposed_by, accepted_by: agreement.accepted_by });
    room.brief = buildBrief(room, { agreement, authority, dependsOn, unverifiedDeps });
    room.status = 'agreed';
  }

  function buildBrief(room, { agreement, authority, dependsOn, unverifiedDeps }) {
    const escalations = room.envelopes.filter(e => e.escalation).map(e => ({
      seat: e.from.seat, principal: e.from.principal, question: e.escalation.question, answer: e.answer || null, via: e.answer_via || null,
    }));
    const allUnverified = Object.values(room.claims).filter(c => !c.verified);
    const challenged = Object.values(room.claims).filter(c => c.reviews.some(r => r.verdict !== 'accept'));
    const flags = room.envelopes.flatMap(e => (e.protocol_flags || []).map(f => ({ seq: e.seq, seat: e.from.seat, flag: f })));
    const check = pxp.verifyLedger(room.ledger);
    const party = s => ({ name: room.seats[s].card.principal.name, card_hash: room.seats[s].cardHash, proxy: proxyLabel(room.seats[s]) });
    return {
      outcome: agreement ? 'agreed' : 'no_agreement',
      agreement, authority,
      depends_on: dependsOn || [],
      unverified_dependencies: unverifiedDeps || [],
      unverified_in_record: allUnverified,
      challenged,
      escalations, protocol_flags: flags,
      parties: { A: party('A'), B: party('B') },
      turns: room.envelopes.length,
      ledger_head: check.head, ledger_ok: check.ok,
      generated_at: iso(),
    };
  }

  // Apply one proxy turn (from either kind of proxy) through protocol enforcement.
  async function advance(room, seatId, raw) {
    const env = pxp.buildEnvelope(room, seatId, raw);
    if (room.seats[seatId].mode === 'external') env.from.agent = agentLabel(room.seats[seatId]);
    pxp.applyEnvelope(room, env);
    room.turnCount++;
    room.thinking = null;
    room.waitingOn = null;

    if (env.status === 'escalate') {
      room.pending = {
        seat: seatId, seq: env.seq, question: env.escalation.question, reason: env.escalation.reason,
        options: room.demo ? demo.options : null,
      };
      room.status = 'paused';
      pxp.appendLedger(room, 'escalation', { seat: seatId, seq: env.seq, question_hash: pxp.sha256(env.escalation.question) });
    } else if (env.status === 'agree') {
      await finalise(room, env);
    } else {
      room.turn = other(seatId);
    }
    emit(room);
    return env;
  }

  // Drive the room until agreement, escalation, the turn cap, an error,
  // or a turn that belongs to an external agent (which then calls in).
  async function run(room) {
    if (room.running || stopped) return;
    room.running = true;
    room.status = 'negotiating';
    room.interrupted = false;
    room.error = null;
    let proxyFailed = false; // the error came from the proxy call, not from this room's own code
    try {
      while (room.status === 'negotiating' && !halted(room)) {
        if (room.turnCount >= room.maxTurns) {
          stall(room, { turnLimit: true });
          break;
        }
        const seatId = room.turn;
        if (room.seats[seatId].mode === 'external') {
          room.waitingOn = seatId;
          room.thinking = null;
          break;
        }
        room.thinking = seatId;
        emit(room);
        let raw;
        if (room.demo) {
          await sleep(DEMO_DELAY);
          if (halted(room)) break; // stopped, or evicted while waiting
          const step = room.script.shift();
          if (!step) { stall(room, { turnLimit: false }); break; }
          raw = step.raw;
        } else {
          try { raw = await proxy.takeTurn(room, seatId); } catch (e) { proxyFailed = true; throw e; }
          if (halted(room)) break; // a busy live room is never evicted, so for it this is only the stop check
        }
        await advance(room, seatId, raw);
      }
    } catch (e) {
      if (stopped) return; // shutting down: leave the status alone so a restart marks the room paused, not error
      logFailure('room.run_failed', room, e);
      if (e instanceof BudgetError || budgetSpent(room)) {
        endSpent(room);
      } else {
        room.status = 'error';
        // Only a fixed sentence reaches room.error; the detail stays in the log.
        room.error = proxyFailed ? AI_ERROR : GENERIC_ERROR;
      }
    } finally {
      room.running = false;
      room.thinking = null;
      if (present(room)) emit(room); // an evicted room has nobody to tell and nothing to save
    }
  }

  async function externalTurn(room, seatId, raw) {
    if (room.status !== 'negotiating' || room.waitingOn !== seatId || room.running) {
      throw new ApiError(409, room.pending ? 'The room is paused for a human answer.' : "It isn't your turn. Call wait_for_turn.");
    }
    room.running = true;
    let env;
    try { env = await advance(room, seatId, raw); }
    finally { room.running = false; }
    if (room.status === 'negotiating') run(room);
    return env;
  }

  function resume(room) {
    if (!resumable(room)) throw new ApiError(409, 'Nothing to resume.');
    if (budgetSpent(room)) { // end the room instead of failing again
      endSpent(room);
      emit(room);
      return;
    }
    run(room);
  }

  function startIfReady(room) {
    if (room.seats.A.sealed && room.seats.B.sealed && room.status === 'drafting') {
      if (room.demo) room.script = demo.opening.slice();
      run(room);
    }
  }

  // ---------- eviction (D3) ----------
  // Last activity is the last ledger entry's time, else the creation time. null when neither parses: such a room is
  // never evicted for age (logged once), because a guess could delete a live room.
  function lastActivity(room) {
    const last = room.ledger && room.ledger[room.ledger.length - 1];
    const t = Date.parse((last && last.at) || room.createdAt);
    if (Number.isNaN(t)) {
      if (!unparsable.has(room.id)) { unparsable.add(room.id); log.warn('room.timestamp_unparsable', { room: room.id }); }
      return null;
    }
    return t;
  }

  function evictRoom(room, reason) {
    rooms.delete(room.id);
    unparsable.delete(room.id);
    store.save(room.id);
    for (const fn of listeners) {
      try { fn(room, 'evicted'); } catch (e) { log.error('room.listener_failed', { room: room.id }, e); }
    }
    log.info('room.evicted', { room: room.id, reason });
  }

  // Compares timestamps only (a 30-day TTL does not fit in a timer). Rooms that are busy are never touched. Returns the
  // number evicted.
  function evictExpired() {
    if (stopped) return 0;
    const t = now();
    let count = 0;
    for (const room of [...rooms.values()]) {
      if (busy(room)) continue;
      const at = lastActivity(room);
      if (at === null) continue;
      if (t - at > (room.demo ? DEMO_TTL_HOURS * HOUR_MS : ROOM_TTL_DAYS * DAY_MS)) { evictRoom(room, 'ttl'); count++; }
    }
    return count;
  }

  // The hard bound on rooms.size, applied when a room is created (and at load and hourly). Past MAX_ROOMS it evicts, oldest
  // first within each tier, down to CAPACITY_MARGIN of the limit:
  //   0 untouched demos (nothing sealed, only room_opened in the ledger)   1 finished demos
  //   2 any other demo, even a running one (a demo holds no outside state; its loop stops when the room is gone)
  //   3 live rooms that are agreed or stalled                              4 live error rooms whose budget is spent
  // A live room that is busy, negotiating, paused, drafting or resumable is never evicted, and neither is `keep` (the
  // room being created). If the rooms that remain cannot be evicted, it logs a warning and carries on.
  const finished = (room) => ['agreed', 'stalled', 'error'].includes(room.status);
  function tierOf(room) {
    if (room.demo) {
      if (!room.seats.A.sealed && !room.seats.B.sealed && room.ledger.length <= 1) return 0;
      if (finished(room)) return 1;
      return 2;
    }
    if (busy(room)) return null;
    if (room.status === 'agreed' || room.status === 'stalled') return 3;
    if (room.status === 'error' && budgetSpent(room)) return 4;
    return null;
  }

  let overCapacityLogged = false; // one warning per episode
  function enforceCapacity(keep) {
    if (rooms.size <= MAX_ROOMS) { overCapacityLogged = false; return 0; }
    const target = Math.floor(MAX_ROOMS * CAPACITY_MARGIN);
    const t = now();
    const order = [...rooms.values()].filter((r) => r !== keep).map((r) => ({ r, tier: tierOf(r) })).filter((x) => x.tier !== null)
      .map((x) => ({ ...x, at: lastActivity(x.r) ?? t })).sort((a, b) => a.tier - b.tier || a.at - b.at);
    let count = 0;
    for (const { r } of order) {
      if (rooms.size <= target) break;
      evictRoom(r, 'capacity'); count++;
    }
    if (rooms.size > MAX_ROOMS && !overCapacityLogged) { overCapacityLogged = true; log.warn('rooms.over_capacity'); }
    if (rooms.size <= MAX_ROOMS) overCapacityLogged = false;
    return count;
  }

  return {
    rooms, ApiError, other, seatLink, hydrate, onChange,
    createDemoRoom, createLiveRoom, draftCard, sealCard, joinAsAgent, busy, chargeCall, evictExpired, enforceCapacity,
    answerEscalation, answerDemo, externalTurn, resume, stop,
  };
}

module.exports = { createRooms, ApiError, BudgetError, ADMIN_DAILY };
